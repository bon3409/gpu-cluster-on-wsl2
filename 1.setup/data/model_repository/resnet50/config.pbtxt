name: "resnet50"
platform: "onnxruntime_onnx"
max_batch_size: 8

input [
  {
    name: "data"
    data_type: TYPE_FP32
    dims: [ 3, 224, 224 ]
  }
]

dynamic_batching {
  # Preferred batch sizes for optimal GPU utilization.
  # Triton will try to form batches of these sizes.
  # Based on test: 9 requests -> 3 executions (batch sizes: 1, 3, 5)
  preferred_batch_size: [4, 8]

  # Maximum time (microseconds) to wait for additional requests
  # to form a larger batch before executing.
  # 10000 us = 10ms delay tolerance.
  max_queue_delay_microseconds: 10000

  # Allow batches smaller than preferred_batch_size if queue delay expires.
  # This prevents excessive latency for low-traffic scenarios.
  preserve_ordering: false

  # Priority levels for request scheduling (optional).
  # priority_levels: 1

  # Default priority for requests (optional, default: 0).
  # default_priority_level: 0

  # Maximum queue size per priority level (optional, 0 = unlimited).
  # max_queue_size: 0
}

output [
  {
    name: "resnetv24_dense0_fwd"
    data_type: TYPE_FP32
    dims: [ 1000 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]